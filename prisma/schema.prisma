generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Le modèle pour l'utilisateur
model User {
  id              Int            @id @default(autoincrement()) // Identifiant unique de l'utilisateur
  username        String         @unique                      // Nom d'utilisateur unique
  email           String?        @unique                      // Email de l'utilisateur (facultatif)
  password        String                                      // Mot de passe de l'utilisateur
  tasks           Task[]         @relation("AssignedTasks")   // Relation avec les tâches assignées à l'utilisateur
  modifiedTasks   TaskHistory[]  @relation("ModifiedByUser")  // Relation avec les tâches modifiées par l'utilisateur
}

// Le modèle pour la tâche
model Task {
  id              Int            @id @default(autoincrement())
  title           String                                      // Titre de la tâche
  description     String                                      // Description de la tâche
  priority        Priority       @relation(fields: [priorityId], references: [id], onDelete: Cascade)
  priorityId      Int                                         // Clé étrangère vers Priority
  dueDate         DateTime                                    // Date limite de la tâche
  status          Status        @relation(fields: [statusId], references: [id], onDelete: Cascade)
  statusId        Int                                         // Clé étrangère vers Status
  assignedTo      User          @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedToId    Int                                         // Clé étrangère vers User
  createdAt       DateTime      @default(now())               // Date de création de la tâche
  history         TaskHistory[] @relation("TaskHistory")      // Retirer onDelete: Cascade ici
}


// Le modèle pour l'historique des tâches
model TaskHistory {
  id                 Int      @id @default(autoincrement()) // Identifiant unique de l’historique
  taskId             Int                                   // Référence à la tâche modifiée
  task               Task     @relation("TaskHistory", fields: [taskId], references: [id], onDelete: Cascade) // Ajouter onDelete: Cascade ici
  modifiedById       Int                                   // Utilisateur ayant effectué la modification
  modifiedBy         User     @relation("ModifiedByUser", fields: [modifiedById], references: [id], onDelete: Cascade) // Relation avec User
  changeDescription  String                                // Description des changements effectués
  modifiedAt         DateTime @default(now())             // Date et heure de la modification
}


// Le modèle pour la priorité des tâches
model Priority {
  id          Int      @id @default(autoincrement()) // Identifiant unique de la priorité
  name        String                                // Nom de la priorité (Faible, Moyenne, Élevée)
  tasks       Task[]                                // Relation entre la priorité et les tâches
}

// Le modèle pour le statut des tâches
model Status {
  id          Int      @id @default(autoincrement()) // Identifiant unique du statut
  name        String                                // Nom du statut de la tâche (ex. "À faire", "En cours", etc.)
  tasks       Task[]                                // Relation entre le statut et les tâches
}