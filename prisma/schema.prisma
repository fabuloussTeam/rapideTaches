generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model Task {
    id          Int      @id @default(autoincrement())
    title       String
    description String
    priority    String   @default("Moyenne")
    dueDate     DateTime // Date limite de la tâche
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    userId      Int      // Clé étrangère pour l'utilisateur assigné
    user        User     @relation(fields: [userId], references: [id])
}

model User {
    id          Int      @id @default(autoincrement())
    name        String
    email       String   @unique
    tasks       Task[]
}