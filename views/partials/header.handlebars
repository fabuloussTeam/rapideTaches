<header>
    <h1>Gestion des Tâches</h1>
    <nav>
        {{#if isAuthenticated}}
        <a href="/">
            <i class="fas fa-home"></i> <!-- Icône d'accueil -->
        </a>
        <a href="/addtask">
            <i class="fas fa-plus-circle"></i> <!-- Icône pour ajouter une tâche -->
        </a>
        <a href="/logout">
            <i class="fas fa-sign-out-alt"></i> <!-- Icône de déconnexion -->
        </a>
        <span>Bienvenue, {{user.name}}</span>
        {{else}}
        <a href="/login">
            <i class="fas fa-sign-in-alt"></i> <!-- Icône de connexion -->
        </a>
        <a href="/inscription">
            <i class="fas fa-user-plus"></i> <!-- Icône d'inscription -->
        </a>
        {{/if}}
    </nav>
</header>