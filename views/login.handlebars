<h2 style="text-align: center;">Connexion</h2>
<form id="form-connexion" action="/login" method="POST">
    <label for="input-courriel">Adresse e-mail:</label>
    <input type="email" id="input-courriel" name="email" required>

    <label for="input-mot-de-passe">Mot de passe:</label>
    <input type="password" id="input-mot-de-passe" name="password" required>

    <button type="submit">Se connecter</button>
</form>
<p style="text-align: center;">Pas encore inscrit ? <a href="/inscription">Créer un compte</a></p>
