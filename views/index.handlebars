<main>
    <h2>Liste des Tâches</h2>
    <div class="task-columns">
        <!-- Colonne "À faire" -->
        <div class="column todo-column" id="column-todo">
            <h3>À faire</h3>
            <ul>
                {{#each tasks}}
                {{#if (eq this.status "À faire")}}
                <li data-task-id="{{this.id}}">
                    <strong>{{this.title}}</strong> - {{this.description}} (Priorité: {{this.priority}})
                    <br>
                    Assignée à: {{this.user.name}} | Date limite: {{formatDate this.dueDate}}
                    <a href="/edit/{{this.id}}">Modifier</a>
                    <a href="/task/{{this.id}}">Détails</a>
                    <a href="/historique/{{this.id}}" class="history-link">Historique</a>

                    <form action="/delete/{{this.id}}" method="POST">
                        <button type="submit">Supprimer</button>
                    </form>
                    <select class="status-select" data-task-id="{{this.id}}">
                        <option value="À faire" {{#if (eq this.status "À faire" )}}selected{{/if}}>À faire</option>
                        <option value="En cours" {{#if (eq this.status "En cours" )}}selected{{/if}}>En cours</option>
                        <option value="En révision" {{#if (eq this.status "En révision" )}}selected{{/if}}>En révision
                        </option>
                        <option value="Terminée" {{#if (eq this.status "Terminée" )}}selected{{/if}}>Terminée</option>
                    </select>
                </li>
                {{/if}}
                {{/each}}
            </ul>
        </div>

        <!-- Colonne "En cours" -->
        <div class="column in-progress-column" id="column-in-progress">
            <h3>En cours</h3>
            <ul>
                {{#each tasks}}
                {{#if (eq this.status "En cours")}}
                <li data-task-id="{{this.id}}"></li>
                <strong>{{this.title}}</strong> - {{this.description}} (Priorité: {{this.priority}})
                <br>
                Assignée à: {{this.user.name}} | Date limite: {{formatDate this.dueDate}}
                <a href="/edit/{{this.id}}">Modifier</a>
                <a href="/task/{{this.id}}">Détails</a>
                <a href="/historique/{{this.id}}" class="history-link">Historique</a>
                <form action="/delete/{{this.id}}" method="POST">
                    <button type="submit">Supprimer</button>
                </form>
                <select class="status-select" data-task-id="{{this.id}}">
                    <option value="À faire" {{#if (eq this.status "À faire" )}}selected{{/if}}>À faire</option>
                    <option value="En cours" {{#if (eq this.status "En cours" )}}selected{{/if}}>En cours</option>
                    <option value="En révision" {{#if (eq this.status "En révision" )}}selected{{/if}}>En révision
                    </option>
                    <option value="Terminée" {{#if (eq this.status "Terminée" )}}selected{{/if}}>Terminée</option>
                </select>
                </li>
                {{/if}}
                {{/each}}
            </ul>
        </div>

        <!-- Colonne "En révision" -->
        <div class="column review-column" id="column-in-review">
            <h3>En révision</h3>
            <ul>
                {{#each tasks}}
                {{#if (eq this.status "En révision")}}
                <li data-task-id="{{this.id}}">
                    <strong>{{this.title}}</strong> - {{this.description}} (Priorité: {{this.priority}})
                    <br>
                    Assignée à: {{this.user.name}} | Date limite: {{formatDate this.dueDate}}
                    <a href="/edit/{{this.id}}">Modifier</a>
                    <a href="/task/{{this.id}}">Détails</a>
                    <a href="/historique/{{this.id}}" class="history-link">Historique</a>

                    <form action="/delete/{{this.id}}" method="POST">
                        <button type="submit">Supprimer</button>
                    </form>
                    <select class="status-select" data-task-id="{{this.id}}">
                        <option value="À faire" {{#if (eq this.status "À faire" )}}selected{{/if}}>À faire</option>
                        <option value="En cours" {{#if (eq this.status "En cours" )}}selected{{/if}}>En cours</option>
                        <option value="En révision" {{#if (eq this.status "En révision" )}}selected{{/if}}>En révision
                        </option>
                        <option value="Terminée" {{#if (eq this.status "Terminée" )}}selected{{/if}}>Terminée</option>
                    </select>
                </li>
                {{/if}}
                {{/each}}
            </ul>
        </div>

        <!-- Colonne "Terminée" -->
        <div class="column done-column" id="column-done">
            <h3>Terminée</h3>
            <ul>
                {{#each tasks}}
                {{#if (eq this.status "Terminée")}}
                <li data-task-id="{{this.id}}">
                    <strong>{{this.title}}</strong> - {{this.description}} (Priorité: {{this.priority}})
                    <br>
                    Assignée à: {{this.user.name}} | Date limite: {{formatDate this.dueDate}}
                    <a href="/edit/{{this.id}}">Modifier</a>
                    <a href="/task/{{this.id}}">Détails</a>
                    <a href="/historique/{{this.id}}" class="history-link">Historique</a>

                    <form action="/delete/{{this.id}}" method="POST">
                        <button type="submit">Supprimer</button>
                    </form>
                    <select class="status-select" data-task-id="{{this.id}}">
                        <option value="À faire" {{#if (eq this.status "À faire" )}}selected{{/if}}>À faire</option>
                        <option value="En cours" {{#if (eq this.status "En cours" )}}selected{{/if}}>En cours</option>
                        <option value="En révision" {{#if (eq this.status "En révision" )}}selected{{/if}}>En révision
                        </option>
                        <option value="Terminée" {{#if (eq this.status "Terminée" )}}selected{{/if}}>Terminée</option>
                    </select>
                </li>
                {{/if}}
                {{/each}}
            </ul>
        </div>

    </div>
    <a style="display: inline-block; padding: 10px 20px; margin: 10px; text-decoration: none; background-color: rgb(224, 82, 82); color: white; border-radius: 5px; font-weight: bold; text-align: center;"
        href="/logout">Déconnexion</a>
</main>